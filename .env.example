NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tdms_pmfilter
DB_USER=pmfilter_app
DB_PASSWORD=replace_with_database_password
DB_CONNECTION_LIMIT=10

KEYCLOAK_URL=https://sso.pealive.com:8081
KEYCLOAK_REALM=OMD
# Configure a Keycloak audience mapper so access tokens include this audience.
KEYCLOAK_AUDIENCE=pmfilter-fe
# Set this if roles are assigned to a specific Keycloak client instead of realm roles.
KEYCLOAK_ROLE_CLIENT_ID=pmfilter-fe

# Optional service-to-service key for cbevent (random secret, at least 32 characters).
# Send as X-API-Key to POST /api/v1/pm/check.
CBEVENT_API_KEY=replace_with_a_random_secret_at_least_32_characters

# Maximum number of records per list response.
MAX_PAGE_SIZE=100
